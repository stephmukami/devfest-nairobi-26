# Copy to .env.local for dev, or .env.production for the Hosting build.

# SSE goes DIRECTLY to Cloud Run (Hosting rewrites cut connections at ~60 s).
# Leave empty in dev to use the Vite proxy.
VITE_STREAM_URL=

# Firebase console > Project settings > Your apps > Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Firebase console > Cloud Messaging > Web Push certificates
VITE_FIREBASE_VAPID_KEY=
