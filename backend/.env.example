# Local dev only. On Cloud Run, GEMINI_API_KEY comes from Secret Manager (--set-secrets).
GEMINI_API_KEY=
# Check AI Studio for the current model name.
GEMINI_MODEL=gemini-2.5-flash
# 0 disables thinking (keeps latency under the 1.5 s budget). Empty = don't send the setting.
GEMINI_THINKING_BUDGET=0
ENRICH_TIMEOUT_S=1.5

# Comma-separated origins allowed to open the SSE stream directly.
ALLOWED_ORIGIN=http://localhost:5173
# Absolute https URL of the web app, for FCM deep links (empty on localhost).
PUBLIC_APP_URL=

# Required header on /api/demo/* when set.
DEMO_KEY=

FCM_ENABLED=true
# Needed locally when ADC has no project (e.g. user credentials).
FIREBASE_PROJECT_ID=
# Local FCM sends: point at a service account key with the Firebase Cloud Messaging Admin role.
# GOOGLE_APPLICATION_CREDENTIALS=C:\path\to\sa.json
# Where FCM device tokens live: memory (lost on restart, no setup) or firestore (needs ADC with
# Cloud Datastore User on the project). Deploys set firestore.
TOKEN_STORE=memory

# Initial kill-switch state (flip live from the stage page).
ENRICH_MODE=gemini
SIMULATE_GEMINI_FAILURE=false
COALESCE=false
